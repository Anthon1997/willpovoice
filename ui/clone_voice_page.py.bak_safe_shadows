    # ------------------------------------------------------------------
    # ICONOS VECTORIALES (QPainter)
    # ------------------------------------------------------------------
    def _make_wave_circle_icon(self, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        # Círculo con gradiente
        grad = QRadialGradient(size/2, size/2, size/2)
        grad.setColorAt(0, QColor(ACCENT_BLUE))
        grad.setColorAt(1, QColor(ACCENT_PURPLE))
        p.setBrush(QBrush(grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(2, 2, size-4, size-4)

        # Ondas blancas
        p.setPen(QPen(QColor("white"), 1.5, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        p.setBrush(Qt.BrushStyle.NoBrush)
        cx, cy = size/2, size/2
        for i, h in enumerate([7, 10, 14, 10, 7]):
            x = cx - 14 + i * 7
            p.drawLine(x, cy - h/2, x, cy + h/2)

        p.end()
        return pixmap

    def _make_dot_icon(self, size, color):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setBrush(QBrush(QColor(color)))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(0, 0, size, size)
        p.end()
        return pixmap

    def _make_small_icon(self, kind, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        if kind == "wave":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 1, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.setBrush(Qt.BrushStyle.NoBrush)
            cx, cy = size/2, size/2
            for i, h in enumerate([4, 7, 10, 7, 4]):
                x = cx - 8 + i * 4
                p.drawLine(x, cy - h/2, x, cy + h/2)
        elif kind == "gear":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(6, 6, size-12, size-12)
            p.drawEllipse(9, 9, size-18, size-18)
        elif kind == "doc":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 0.8))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRoundedRect(7, 6, size-14, size-10, 2, 2)
            for i in range(3):
                y = 9 + i * 3
                p.drawLine(9, y, size-9, y)

        p.end()
        return pixmap

    def _make_music_icon(self, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        grad = QLinearGradient(0, 0, size, size)
        grad.setColorAt(0, QColor(ACCENT_BLUE))
        grad.setColorAt(1, QColor(ACCENT_PURPLE))
        p.setPen(QPen(QBrush(grad), 2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        p.setBrush(Qt.BrushStyle.NoBrush)

        cx, cy = size/2, size/2
        p.drawEllipse(int(cx-7), int(cy+2), 10, 10)
        p.drawLine(int(cx+3), int(cy+7), int(cx+3), int(cy-10))
        p.drawEllipse(int(cx-1), int(cy-14), 12, 7)

        p.end()
        return pixmap

    def _make_file_icon(self, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        grad = QLinearGradient(0, 0, size, size)
        grad.setColorAt(0, QColor(ACCENT_BLUE))
        grad.setColorAt(1, QColor(ACCENT_PURPLE))
        p.setBrush(QBrush(grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)

        p.setPen(QPen(QColor("white"), 1))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawRoundedRect(7, 6, size-14, size-10, 2, 2)
        p.drawEllipse(10, size//2-3, 5, 5)
        p.drawLine(15, size//2-1, 15, 9)
        p.drawEllipse(13, 6, 5, 4)

        p.end()
        return pixmap

    # ------------------------------------------------------------------
    # FUNCIONALIDAD
    # ------------------------------------------------------------------
    def _select_audio(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Seleccionar Audio", "",
            "Archivos WAV (*.wav);;Todos los archivos (*)"
        )
        if path:
            self._wav_path = path
            name = os.path.basename(path)
            size_mb = os.path.getsize(path) / (1024 * 1024)
            self.preview_name.setText(name)
            self.preview_meta.setText(f"WAV  {size_mb:.1f} MB")
            self.drop_zone.hide()
            self.file_preview.show()
            print(f"Audio cargado: {name}")

    def _clear_audio(self):
        self._wav_path = None
        self.file_preview.hide()
        self.drop_zone.show()
        print("Audio eliminado")

    def eventFilter(self, obj, event):
        from PySide6.QtCore import QEvent
        if event.type() == QEvent.Type.Resize and hasattr(self, 'ondas_label') and not self.ondas_pixmap.isNull():
            header = self.findChild(QFrame)
            if header:
                scaled = self.ondas_pixmap.scaled(
                    header.size(),
                    Qt.AspectRatioMode.IgnoreAspectRatio,
                    Qt.TransformationMode.SmoothTransformation
                )
                self.ondas_label.setPixmap(scaled)
                self.ondas_label.setGeometry(0, 0, header.width(), header.height())
        return super().eventFilter(obj, event)

    def _start_cloning(self):
        if not self._wav_path:
            print("Selecciona un archivo de audio primero")
            return
        text = self.text_area.toPlainText().strip()
        if not text:
            print("Escribe el texto a generar")
            return

        speed = self.speed_slider.value() / 100
        lang = "spanish"
        print(f"Iniciando clonación...")
        print(f"  Audio: {self._wav_path}")
        print(f"  Texto: {text[:60]}...")
        print(f"  Velocidad: {speed}x")

        try:
            from core.pocket_cloner import cloner_instance
            out = cloner_instance.clone_and_generate(self._wav_path, text, lang)
            print(f"Audio clonado generado: {out}")
        except Exception as e:
            print(f"Error: {e}")
