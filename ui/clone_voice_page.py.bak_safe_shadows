    def _build_text_card(self):
        card = QFrame()
        card.setStyleSheet(f"""
            QFrame {{
                background: {BG_CARD};
                border-radius: 12px;
                border: 1px solid {BORDER};
            }}
        """)
        layout = QVBoxLayout(card)
        layout.setContentsMargins(16, 12, 16, 12)
        layout.setSpacing(8)

        header = QHBoxLayout()
        header.setSpacing(8)
        header.setContentsMargins(0, 0, 0, 0)

        icon = QLabel()
        icon.setPixmap(self._make_small_icon("doc", 24))
        icon.setFixedSize(26, 26)
        header.addWidget(icon)

        title = QLabel("Texto para generar")
        title.setStyleSheet(f"""
            color: {TEXT_PRIMARY};
            font-size: 15px;
            font-weight: 600;
            border: none;
        """)
        header.addWidget(title)
        header.addStretch()
        layout.addLayout(header)

        subtitle = QLabel("Escribe el texto que quieres convertir en voz con la voz clonada.")
        subtitle.setStyleSheet(f"""
            color: {TEXT_SECONDARY};
            font-size: 10px;
            border: none;
        """)
        layout.addWidget(subtitle)

        # Área de texto con botones integrados
        text_container = QFrame()
        text_container.setStyleSheet(f"""
            QFrame {{
                background: {BG_INPUT};
                border: 1px solid {BORDER};
                border-radius: 8px;
            }}
        """)
        text_layout = QVBoxLayout(text_container)
        text_layout.setContentsMargins(10, 10, 10, 10)
        text_layout.setSpacing(0)

        self.text_area = QTextEdit()
        self.text_area.setPlaceholderText("Escribe aquí el texto que quieres escuchar con la voz seleccionada...")
        self.text_area.setStyleSheet(f"""
            QTextEdit {{
                background: transparent;
                border: none;
                color: {TEXT_PRIMARY};
                font-size: 10px;
                min-height: 80px;
                max-height: 80px;
                selection-background-color: {ACCENT_PURPLE};
            }}
            QTextEdit:focus {{
                border: none;
            }}
        """)
        self.text_area.textChanged.connect(self._update_char_count)
        text_layout.addWidget(self.text_area)

        # Botones dentro del área de texto
        btn_row = QHBoxLayout()
        btn_row.setContentsMargins(0, 6, 0, 0)
        btn_row.setSpacing(6)
        btn_row.addStretch()

        paste_btn = QPushButton("📋 Pegar")
        paste_btn.setStyleSheet(self._secondary_btn_style())
        paste_btn.setFixedHeight(28)
        paste_btn.clicked.connect(self._paste_text)
        btn_row.addWidget(paste_btn)

        clear_btn = QPushButton("🗑 Limpiar")
        clear_btn.setStyleSheet(self._secondary_btn_style())
        clear_btn.setFixedHeight(28)
        clear_btn.clicked.connect(self.text_area.clear)
        btn_row.addWidget(clear_btn)

        text_layout.addLayout(btn_row)
        layout.addWidget(text_container)

        # Contador
        self.char_counter = QLabel("0 / 5000")
        self.char_counter.setStyleSheet(f"""
            color: {TEXT_MUTED};
            font-size: 10px;
            border: none;
        """)
        layout.addWidget(self.char_counter)

        return card

    def _secondary_btn_style(self):
        return f"""
            QPushButton {{
                background: {BG_CARD};
                border: 1px solid {BORDER};
                border-radius: 5px;
                color: {TEXT_SECONDARY};
                padding: 0 10px;
                font-size: 10px;
            }}
            QPushButton:hover {{
                background: {BORDER_LIGHT};
                color: {TEXT_PRIMARY};
            }}
        """

    def _update_char_count(self):
        n = len(self.text_area.toPlainText())
        self.char_counter.setText(f"{n} / 5000")

    def _paste_text(self):
        clipboard = QApplication.clipboard()
        self.text_area.insertPlainText(clipboard.text())

