    def _make_wave_circle_icon(self, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        # Círculo con glow
        grad = QRadialGradient(size/2, size/2, size/2)
        grad.setColorAt(0, QColor(ACCENT_BLUE))
        grad.setColorAt(1, QColor(ACCENT_PURPLE))
        p.setBrush(QBrush(grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(2, 2, size-4, size-4)

        # Ondas blancas
        p.setPen(QPen(QColor("white"), 2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        p.setBrush(Qt.BrushStyle.NoBrush)
        cx, cy = size/2, size/2
        for i, h in enumerate([10, 16, 22, 16, 10]):
            x = cx - 20 + i * 10
            p.drawLine(x, cy - h/2, x, cy + h/2)

        p.end()
        return pixmap

