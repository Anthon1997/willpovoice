        elif kind == "gear":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 6, 6)
            p.setPen(QPen(QColor("white"), 1.5))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(8, 8, size-16, size-16)
            p.drawEllipse(11, 11, size-22, size-22)
        elif kind == "doc":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 6, 6)
            p.setPen(QPen(QColor("white"), 1.2))
            p.setBrush(Qt.BrushStyle.NoBrush)
