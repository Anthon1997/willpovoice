    def _header_paint_event(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.fillRect(self.rect(), QColor(BG_HEADER))

        # Ondas decorativas en el fondo
        painter.setPen(Qt.PenStyle.NoPen)
        for i in range(3):
            path = QPainterPath()
            y_offset = 30 + i * 15
            alpha = 40 - i * 10
            color = QColor(ACCENT_BLUE)
            color.setAlpha(alpha)
            painter.setBrush(QBrush(color))

            path.moveTo(0, y_offset)
            for x in range(0, self.width(), 5):
                y = y_offset + 20 * (0.5 + 0.5 * __import__("math").sin(x * 0.015 + i))
                path.lineTo(x, y)
            path.lineTo(self.width(), self.height())
            path.lineTo(0, self.height())
            path.closeSubpath()
            painter.drawPath(path)
        painter.end()

