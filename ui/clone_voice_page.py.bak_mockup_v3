            p.setPen(QPen(QColor("white"), 1.5, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.setBrush(Qt.BrushStyle.NoBrush)
            cx, cy = size/2, size/2
            for i, h in enumerate([6, 10, 14, 10, 6]):
                x = cx - 12 + i * 6
