    def _create_wave_icon(self):
        """Icono de ondas de audio"""
        pixmap = QPixmap(48, 48)
        pixmap.fill(Qt.GlobalColor.transparent)
        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        gradient = QLinearGradient(0, 0, 48, 48)
        gradient.setColorAt(0, QColor(ACCENT_PURPLE))
        gradient.setColorAt(1, QColor(ACCENT_BLUE))
        painter.setBrush(QBrush(gradient))
        painter.setPen(Qt.PenStyle.NoPen)
        
        # Dibujar ondas
        for i in range(5):
            x = 8 + i * 8
            h = 12 + (i % 3) * 8
            y = 24 - h // 2
            painter.drawRoundedRect(x, y, 6, h, 3, 3)
            
        painter.end()
        return pixmap
        
