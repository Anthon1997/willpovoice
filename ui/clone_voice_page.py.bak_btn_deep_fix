    def _make_small_icon(self, kind, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        if kind == "wave":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 1, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.setBrush(Qt.BrushStyle.NoBrush)
            cx, cy = size/2, size/2
            for i, h in enumerate([4, 7, 10, 7, 4]):
                x = cx - 8 + i * 4
                p.drawLine(x, cy - h/2, x, cy + h/2)
        elif kind == "gear":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(6, 6, size-12, size-12)
            p.drawEllipse(9, 9, size-18, size-18)
        elif kind == "doc":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 4, 4)
            p.setPen(QPen(QColor("white"), 0.8))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRoundedRect(7, 6, size-14, size-10, 2, 2)
            for i in range(3):
                y = 9 + i * 3
                p.drawLine(9, y, size-9, y)

        p.end()
        return pixmap

