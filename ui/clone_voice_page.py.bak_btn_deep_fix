    def _toggle_play(self):
        """Play / pausa del audio de referencia"""
        from PySide6.QtMultimedia import QMediaPlayer
        if not self._wav_path:
            return
        if self._media_player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self._media_player.pause()
        else:
            self._media_player.play()

    def _on_playback_state(self, state):
        """Cambia el icono play <-> pause"""
        from PySide6.QtMultimedia import QMediaPlayer
        svg_dir = Path(__file__).resolve().parents[1] / "assets" / "icons" / "svg"
        if state == QMediaPlayer.PlaybackState.PlayingState:
            icon = self._load_svg_colored(str(svg_dir / "pause.svg"), "#ffffff", 32)
        else:
            icon = self._load_svg_colored(str(svg_dir / "play.svg"), "#ffffff", 32)
        if not icon.isNull():
            self.play_btn.setIcon(QIcon(icon))

    def _on_position_changed(self, ms):
        if getattr(self, "_seeking", False):
            return
        dur = self._media_player.duration() or 0
        if dur > 0:
            self.track_slider.blockSignals(True)
            self.track_slider.setValue(int(ms * 100 // dur))
            self.track_slider.blockSignals(False)
        self.time_label.setText(f"{self._fmt_ms(ms)} / {self._fmt_ms(dur)}")

    def _on_duration_changed(self, ms):
        self.time_label.setText(f"00:00 / {self._fmt_ms(ms)}")

    def _on_slider_released(self):
        self._seeking = False
        dur = self._media_player.duration() or 0
        if dur > 0:
            self._media_player.setPosition(int(dur * self.track_slider.value() // 100))

    def _fmt_ms(self, ms):
        s = int(ms // 1000)
        return f"{s // 60:02d}:{s % 60:02d}"

    def _wav_duration(self, path):
        """Duracion real del WAV en mm:ss"""
        try:
            import wave
            with wave.open(path, "rb") as w:
                secs = w.getnframes() / float(w.getframerate())
            m, s = divmod(int(secs), 60)
            return f"{m:02d}:{s:02d}"
        except Exception:
            return "00:00"

    def _select_audio(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Seleccionar Audio", "",
            "Archivos WAV (*.wav);;Todos los archivos (*)"
        )
        if path:
            self._wav_path = path
            name = os.path.basename(path)
            size_mb = os.path.getsize(path) / (1024 * 1024)
            dur = self._wav_duration(path)
            self.preview_name.setText(name)
            self.preview_meta.setText(f"WAV  •  {size_mb:.1f} MB  •  {dur}")
            self.time_label.setText(f"00:00 / {dur}")
            self.preview_empty.hide()
            self.preview_content.show()
            # Cargar el WAV en el reproductor
            from PySide6.QtCore import QUrl
            self._media_player.stop()
            self._media_player.setSource(QUrl.fromLocalFile(path))
            self.track_slider.setValue(0)
            print(f"Audio cargado: {name}")

    def _clear_audio(self):
        self._wav_path = None
        self._media_player.stop()
        self._media_player.setSource(QUrl())
        self.track_slider.setValue(0)
        self.time_label.setText("00:00 / 00:00")
        self.preview_content.hide()
        self.preview_empty.show()
        print("Audio eliminado")

    def eventFilter(self, obj, event):
        from PySide6.QtCore import QEvent
        if event.type() == QEvent.Type.Resize and hasattr(self, 'ondas_label') and not self.ondas_pixmap.isNull():
            header = self.findChild(QFrame)
            if header:
                scaled = self.ondas_pixmap.scaled(
                    header.size(),
                    Qt.AspectRatioMode.IgnoreAspectRatio,
                    Qt.TransformationMode.SmoothTransformation
                )
                self.ondas_label.setPixmap(scaled)
                self.ondas_label.setGeometry(0, 0, header.width(), header.height())
        return super().eventFilter(obj, event)

    def _start_cloning(self):
        if not self._wav_path:
            print("Selecciona un archivo de audio primero")
            return
        text = self.text_area.toPlainText().strip()
        if not text:
            print("Escribe el texto a generar")
            return

        # Mostrar barra de progreso, ocultar botón
        self.clone_btn.hide()
        self.progress_bar.show()
        self.progress_bar.setRange(0, 0)  # Modo indeterminado (animado)
        self.progress_bar.setTextVisible(True)
        self.progress_bar.setFormat("Clonando y generando audio...")
        
        speed = self.speed_slider.value() / 100
        lang = "spanish"
        print(f"Iniciando clonación...")
        print(f"  Audio: {self._wav_path}")
        print(f"  Texto: {text[:60]}...")
        print(f"  Velocidad: {speed}x")

        try:
            from core.pocket_cloner import cloner_instance
            out = cloner_instance.clone_and_generate(self._wav_path, text, lang)
            print(f"Audio clonado generado: {out}")
            
            # Restaurar botón después de completar
            self.progress_bar.setTextVisible(False)
            self.progress_bar.hide()
            self.clone_btn.show()
        except Exception as e:
            print(f"Error: {e}")
            # Restaurar botón en caso de error
            self.progress_bar.setTextVisible(False)
            self.progress_bar.hide()
            self.clone_btn.show()
