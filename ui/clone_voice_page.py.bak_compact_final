    def _make_small_icon(self, kind, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        if kind == "wave":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 5, 5)
            p.setPen(QPen(QColor("white"), 1.2, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
            p.setBrush(Qt.BrushStyle.NoBrush)
            cx, cy = size/2, size/2
            for i, h in enumerate([5, 8, 11, 8, 5]):
                x = cx - 10 + i * 5
                p.drawLine(x, cy - h/2, x, cy + h/2)
        elif kind == "gear":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 5, 5)
            p.setPen(QPen(QColor("white"), 1.2))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawEllipse(7, 7, size-14, size-14)
            p.drawEllipse(10, 10, size-20, size-20)
        elif kind == "doc":
            grad = QLinearGradient(0, 0, size, size)
            grad.setColorAt(0, QColor(ACCENT_BLUE))
            grad.setColorAt(1, QColor(ACCENT_PURPLE))
            p.setBrush(QBrush(grad))
            p.setPen(Qt.PenStyle.NoPen)
            p.drawRoundedRect(2, 2, size-4, size-4, 5, 5)
            p.setPen(QPen(QColor("white"), 1))
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRoundedRect(8, 7, size-16, size-12, 2, 2)
            for i in range(3):
                y = 10 + i * 4
                p.drawLine(10, y, size-10, y)

        p.end()
        return pixmap

    def _make_music_icon(self, size):
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)
        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        grad = QLinearGradient(0, 0, size, size)
