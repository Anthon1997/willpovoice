    # ------------------------------------------------------------------
    def _select_audio(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Seleccionar Audio", "",
            "Archivos WAV (*.wav);;Todos los archivos (*)"
        )
        if path:
            self._wav_path = path
            name = os.path.basename(path)
            size_mb = os.path.getsize(path) / (1024 * 1024)
            self.preview_name.setText(name)
            self.preview_meta.setText(f"WAV  {size_mb:.1f} MB")
            self.drop_zone.hide()
            self.file_preview.show()
            print(f"Audio cargado: {name}")

    def _clear_audio(self):
        self._wav_path = None
        self.file_preview.hide()
        self.drop_zone.show()
        print("Audio eliminado")

    def _start_cloning(self):
        if not self._wav_path:
            print("Selecciona un archivo de audio primero")
            return
        text = self.text_area.toPlainText().strip()
        if not text:
            print("Escribe el texto a generar")
            return

        speed = self.speed_slider.value() / 100
        lang = "spanish"
        print(f"Iniciando clonación...")
        print(f"  Audio: {self._wav_path}")
        print(f"  Texto: {text[:60]}...")
        print(f"  Velocidad: {speed}x")

        try:
            from core.pocket_cloner import cloner_instance
            out = cloner_instance.clone_and_generate(self._wav_path, text, lang)
            print(f"Audio clonado generado: {out}")
        except Exception as e:
            print(f"Error: {e}")
