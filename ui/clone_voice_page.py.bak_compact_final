        clear_btn.setStyleSheet(self._secondary_btn_style())
        clear_btn.setFixedHeight(32)
        clear_btn.clicked.connect(self.text_area.clear)
        footer.addWidget(clear_btn)

        layout.addLayout(footer)
        return card

