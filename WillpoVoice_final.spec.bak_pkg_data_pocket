# -*- mode: python ; coding: utf-8 -*-
from PyInstaller.utils.hooks import collect_data_files
from pathlib import Path

datas = []
for d in ("assets", "resources", "img", "images", "fotos"):
    if Path(d).exists():
        datas.append((d, d))
# Modelos de Pocket TTS (offline)
models_dir = Path("models/pocket_tts")
if models_dir.exists():
    datas.append(("models/pocket_tts", "models/pocket_tts"))
for pkg in ("docx", "lxml"):
    try:
        datas += collect_data_files(pkg)
    except Exception:
        pass

a = Analysis(
    ["run.py"],
    pathex=[],
    binaries=[],
    datas=datas,
    hiddenimports=[
        "comtypes", "comtypes.client",
        "win32com", "win32com.client",
        "pythoncom", "pywintypes", "win32timezone",
    ],
    hookspath=["hooks"],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)
exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="WillpoVoice",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,
    icon="assets/icons/app.ico",
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="WillpoVoice",
)


